{
  "mcpServers": {
    "vnkvm": {
      "command": "/bin/sh",
      "args": ["-c", "exec ./scripts/vnkvm-mcp \"$@\"", "--"],
      "cwd": ".",
      "env_vars": ["PATH", "HOME", "GOPATH", "GOCACHE", "GOMODCACHE", "VNKVM_INPUT", "VNKVM_ALLOW_DISPLAY", "VNKVM_LESSONS_DIR"],
      "startup_timeout_sec": 120
    }
  }
}

#!/bin/sh
# Launches the vnkvm MCP server, building it first when the binary is missing
# or older than the source. Needs Go and the Xcode command line tools.
#
# VNKVM_INPUT picks the input path: sys (default, needs Accessibility) or
# driver (virtual USB HID, needs the Karabiner driver and vnkvm-hid-bridge).
set -e
# Apps started from the Dock get a minimal PATH; add where Go usually lives.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:$HOME/go/bin"
root=$(cd "$(dirname "$0")/.." && pwd)
bin="$root/bin/vnkvm"

if [ ! -x "$bin" ] || [ -n "$(find "$root/cmd" "$root/internal" "$root/go.mod" -newer "$bin" -name '*.go' -o -newer "$bin" -name go.mod 2>/dev/null | head -1)" ]; then
	if ! command -v go >/dev/null 2>&1; then
		echo "vnkvm: Go is required to build the server. Install everything with:" >&2
		echo "  curl -fsSL https://raw.githubusercontent.com/Lucklyric/virtual-nanokvm/main/install.sh | bash" >&2
		exit 1
	fi
	(cd "$root" && go build -o "$bin" ./cmd/vnkvm) >&2
fi

exec "$bin" mcp --input "${VNKVM_INPUT:-sys}" "$@"
